{
  "name": "v2ray-fetcher-bot",
  "version": "2.0.0",
  "description": "A Telegram bot system to fetch, test, and post V2Ray configs.",
  "main": "bot.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "start:tester": "node dist/index.js tester",
    "start:bot": "node dist/index.js bot",
    "dev:tester": "tsx src/index.ts tester",
    "dev:bot": "tsx src/index.ts bot",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "node-telegram-bot-api": "^0.64.0",
    "socks-proxy-agent": "^8.0.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-telegram-bot-api": "^0.64.0",
    "@types/sqlite3": "^3.1.11",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
